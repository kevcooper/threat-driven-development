{
  "version": 1,
  "base_branch": "main",
  "models": [
    "threats/**/*.tc.json"
  ],
  "ignore": [
    "docs/**",
    "README.md",
    "LICENSE*",
    ".gitignore"
  ],
  "declaration": {
    "min_length": 30
  },
  "policy": {
    "red": "block-new",
    "config_from_base": true
  },
  "hooks": {
    "commit_msg": "warn",
    "pre_push": "block",
    "claude_stop": "block"
  },
  "checks": {
    "action-no-interpolation": {
      "run": "python3 -m unittest -q tests.test_security_controls.ActionInjectionTests",
      "description": "PR text reaches the action only through env vars"
    },
    "policy-from-base": {
      "run": "python3 -m unittest -q tests.test_status_ci.CITests.test_head_cannot_weaken_policy",
      "description": "CI reads policy from the base branch"
    },
    "declaration-quality": {
      "run": "python3 -m unittest -q tests.test_security_controls.DeclarationQualityTests tests.test_gate.GateTests.test_boilerplate_declaration_rejected tests.test_gate.GateTests.test_commit_trailer",
      "description": "boilerplate declarations are rejected"
    },
    "checks-by-name-only": {
      "run": "python3 -m unittest -q tests.test_security_controls.ChecksByNameTests",
      "description": "check tags are names, never shell"
    },
    "hooks-do-not-run-checks": {
      "run": "python3 -m unittest -q tests.test_security_controls.HooksDoNotRunChecksTests",
      "description": "Claude hooks never execute repo-defined commands"
    },
    "ci-backstop": {
      "run": "python3 -m unittest -q tests.test_security_controls.CIBackstopTests",
      "description": "the PR workflow runs the gate with full history"
    },
    "formatting-not-delta": {
      "run": "python3 -m unittest -q tests.test_gate.GateTests.test_formatting_only_change_is_not_a_delta",
      "description": "reformatting a model does not satisfy the gate"
    },
    "tc-canonical-format": {
      "run": "python3 -m unittest -q tests.test_canonical tests.test_hooks.ClaudeHookTests.test_post_tool_use_reformats_to_threat_composer_form tests.test_hooks.ClaudeHookTests.test_post_tool_use_blocks_text_threat_composer_would_mangle",
      "description": "models are written exactly as the Threat Composer editor saves them"
    },
    "mitigation-status": {
      "run": "python3 -m unittest -q tests.test_status_ci.MitigationStatusTests tests.test_status_ci.StatusTests.test_planned_vs_resolved_failing_checks",
      "description": "mitigation status matches its checks"
    },
    "risk-strategy-tags": {
      "run": "python3 -m unittest -q tests.test_status_ci.StrategyTests tests.test_status_ci.MitigationStatusTests.test_threat_not_resolved_without_strategy tests.test_schema.LintCommandTests.test_schema_only",
      "description": "a threat resolves only under one explicit risk strategy tag"
    },
    "official-schema": {
      "run": "python3 -m unittest -q tests.test_schema",
      "description": "models validate against the vendored Threat Composer schema"
    },
    "tag-safety": {
      "run": "python3 -m unittest -q tests.test_tagging.TaggingTests.test_model_names_are_ref_safe tests.test_tagging.TaggingTests.test_non_integer_numeric_id_skipped_with_warning tests.test_tagging.TaggingTests.test_foreign_tag_is_left_alone tests.test_tagging.TaggingTests.test_model_text_cannot_reach_a_shell tests.test_security_controls.TagWriteTokenTests",
      "description": "mitigation tags can't inject into git or leak a write token to PRs"
    }
  }
}
